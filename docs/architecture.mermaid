graph TD
    subgraph "User Layer"
        U[Neovim User]
        KM["&lt;leader&gt;t (global toggle)"]
        BK["&lt;leader&gt;1..9 / &lt;leader&gt;e / q<br/>(buffer-local, jot window only)"]
    end

    subgraph "Plugin Entry"
        P["plugin/jot.lua<br/>(auto-loaded, double-load guard)"]
    end

    subgraph "Public API — lua/jot/init.lua"
        SETUP["setup(user_config)"]
        TOGGLE["toggle()"]
        SWITCH["switch(slot)"]
        MGR["open_manager()"]
    end

    subgraph "Config — lua/jot/config.lua"
        DEFAULTS["Default config<br/>(dir, window, keymaps, slots seed)"]
        MERGE["Deep-merge user config"]
        CFG["Resolved config table"]
    end

    subgraph "Slots — lua/jot/slots.lua"
        BIND["bindings<br/>(slot 1..9 -> abs path)"]
        LOAD["load() / save()"]
        MANAGER["open_manager()<br/>+ _commit()"]
        JSON["slots.json<br/>stdpath('data')/jot/slots.json"]
    end

    subgraph "Window — lua/jot/window.lua"
        STATE["state (win_id, current_slot)<br/>+ per-path buf cache"]
        OPEN["open(cfg, slot)"]
        SW["switch(cfg, slot)<br/>swap buffer in place + autosave"]
        CLOSE["close() + autosave"]
        ATTACH["attach_keymaps()<br/>buffer-local switch/manager/close"]
    end

    subgraph "Filesystem"
        NOTES["Notes<br/>stdpath('data')/jot/*.md"]
    end

    U -->|presses| KM
    U -->|inside window| BK
    KM --> TOGGLE
    BK --> SWITCH
    BK --> MGR
    P --> SETUP
    SETUP --> MERGE
    DEFAULTS --> MERGE
    MERGE --> CFG
    SETUP --> LOAD
    LOAD --> JSON
    LOAD --> BIND
    MGR --> MANAGER
    MANAGER --> JSON
    MANAGER --> BIND
    CFG --> TOGGLE
    TOGGLE --> STATE
    STATE -->|win not open| OPEN
    STATE -->|win open| CLOSE
    SWITCH --> SW
    OPEN --> BIND
    SW --> BIND
    OPEN --> ATTACH
    OPEN --> NOTES
    SW --> NOTES
    CLOSE --> NOTES
